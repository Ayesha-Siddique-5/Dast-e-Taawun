<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Purple Header Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#9B88BD"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_centerInParent="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Make a Donation"
                    android:textSize="42sp"
                    android:textColor="#000000"
                    android:fontFamily="cursive"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help someone in need today"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:alpha="0.8" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Payment Method Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pistachio_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAYMENT METHOD"
                    android:textSize="11sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:alpha="0.9"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/paymentMethodRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/cashRadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash Donation"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:checked="true"
                        android:buttonTint="#7B6B8E"
                        android:padding="8dp" />

                    <RadioButton
                        android:id="@+id/onlineRadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online Payment"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:buttonTint="#7B6B8E"
                        android:padding="8dp" />

                </RadioGroup>

            </LinearLayout>

            <!-- Anonymous Donation Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pistachio_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <CheckBox
                    android:id="@+id/anonymousCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Make this donation anonymous"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:buttonTint="#7B6B8E"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Donate Button -->
            <Button
                android:id="@+id/donateButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="DONATE NOW"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/purple_button"
                android:elevation="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Material Donation Button -->
            <Button
                android:id="@+id/materialDonationButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="DONATE MATERIALS"
                android:textColor="#9B88BD"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/outlined_button"
                android:elevation="2dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>