<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Purple Header Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#9B88BD"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_centerInParent="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Donate Materials"
                    android:textSize="42sp"
                    android:textColor="#000000"
                    android:fontFamily="cursive"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Donate clothes, food, or other items"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:alpha="0.8" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Item Type Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pistachio_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ITEM TYPE"
                    android:textSize="11sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:alpha="0.9"
                    android:layout_marginBottom="12dp" />

                <Spinner
                    android:id="@+id/itemTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/item_types"
                    android:background="@android:color/transparent"
                    android:minHeight="48dp"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <!-- Item Description Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pistachio_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ITEM DESCRIPTION"
                    android:textSize="11sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:alpha="0.9"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/itemDescriptionEditText"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:hint="Describe the items you want to donate"
                    android:inputType="textMultiLine"
                    android:textColor="#000000"
                    android:textColorHint="#666666"
                    android:textSize="16sp"
                    android:gravity="top|start"
                    android:background="@android:color/transparent"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Item Condition Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pistachio_card"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONDITION"
                    android:textSize="11sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:alpha="0.9"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/itemConditionEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., New, Gently Used, Good Condition"
                    android:inputType="text"
                    android:textColor="#000000"
                    android:textColorHint="#666666"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@android:color/transparent" />

            </LinearLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="SUBMIT DONATION"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/purple_button"
                android:elevation="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="#9B88BD"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>